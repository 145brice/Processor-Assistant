# AI Provider (OpenAI-compatible - works with Grok, GPT-4, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb-secret-key-here
SUPABASE_ANON_KEY=your-anon-or-sb-publishable-key-here

# Stable random server secret: never commit the real value or rotate without migration.
PA_SETTINGS_ENCRYPTION_KEY=
# Local fallback; hosted attachments should use a persistent volume at this path.
PA_EMAIL_DATA_DIR=

# Stripe (Phase 2 - leave blank for now)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_SIGNUP=
STRIPE_PRICE_ID_FILE=
